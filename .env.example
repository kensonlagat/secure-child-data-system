# Copy this file to .env and fill in real values. Never commit .env itself.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# The web app connects as the low-privilege app role (see README "Database roles").
# postgresql://<user>:<password>@localhost:5432/<db_name>
DATABASE_URL=postgresql+psycopg2://cds_app:<app-role-password>@localhost:5432/child_data_system

# Migrations run as the schema owner role. Only needed when running `flask db upgrade`.
MIGRATION_DATABASE_URL=postgresql+psycopg2://cds_owner:<owner-role-password>@localhost:5432/child_data_system

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Africa's Talking sandbox credentials (https://account.africastalking.com)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
