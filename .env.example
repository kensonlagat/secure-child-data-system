# Copy this file to .env and fill in real values. Never commit .env itself.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# postgresql://<user>:<password>@localhost:5432/<db_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/child_data_system

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Africa's Talking sandbox credentials (https://account.africastalking.com)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
